+++ b/internal/agent/opencode_cancel_test.go
@@ -0,0 +1,173 @@
+package agent
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenCodeInterruptHelper(t *testing.T) {
+	if os.Getenv("ROBOREV_INTERRUPT_HELPER") != "1" {
+		return
+	}
+	interrupt := make(chan os.Signal, 1)
+	signal.Notify(interrupt, os.Interrupt)
+	fmt.Println(`{"type":"step_start","sessionID":"ses_review"}`)
+	<-interrupt
+	// Cleanup is deliberately slower than the streaming runner's pipe deadline.
+	time.Sleep(500 * time.Millisecond)
+	if err := os.WriteFile(os.Getenv("ROBOREV_INTERRUPT_MARKER"), []byte("ses_review idle"), 0o600); err != nil {
+		os.Exit(1)
+	}
+	fmt.Println(`{"type":"session_cancelled","sessionID":"ses_review"}`)
+	if os.Getenv("ROBOREV_INTERRUPT_EXIT_ZERO") == "true" {
+		os.Exit(0)
+	}
+	os.Exit(130)
+}
+
+type interruptReadyWriter struct {
+	once   sync.Once
+	cancel context.CancelFunc
+}
+
+func (w *interruptReadyWriter) Write(p []byte) (int, error) {
+	w.once.Do(w.cancel)
+	return len(p), nil
+}
+
+func TestOpenCodeReviewWaitsForInterruptCleanup(t *testing.T) {
+	skipIfWindows(t)
+	for _, tc := range []struct {
+		deadline bool
+		exitZero bool
+	}{{false, false}, {false, true}, {true, false}, {true, true}} {
+		t.Run(fmt.Sprintf("deadline=%t/exitZero=%t", tc.deadline, tc.exitZero), func(t *testing.T) {
+			binary, err := os.Executable()
+			require.NoError(t, err)
+			marker := filepath.Join(t.TempDir(), "cleaned")
+			t.Setenv("ROBOREV_INTERRUPT_HELPER", "1")
+			t.Setenv("ROBOREV_INTERRUPT_MARKER", marker)
+			t.Setenv("ROBOREV_INTERRUPT_EXIT_ZERO", fmt.Sprint(tc.exitZero))
+			command := writeTempCommand(t, fmt.Sprintf("#!/bin/sh\ncase \"$1\" in *etxtbsy*) exit 0;; esac\nexec %q -test.run=^TestOpenCodeInterruptHelper$\n", binary))
+			ctx, cancel := context.WithCancel(context.Background())
+			trigger := cancel
+			want := context.Canceled
+			if tc.deadline {
+				cancel()
+				ctx, cancel = context.WithTimeout(context.Background(), 2*time.Second)
+				trigger = func() {}
+				want = context.DeadlineExceeded
+			}
+			defer cancel()
+			_, err = NewOpenCodeAgent(command).Review(ctx, t.TempDir(), "HEAD", "review", &interruptReadyWriter{cancel: trigger})
+			require.ErrorIs(t, err, want)
+			require.NotContains(t, err.Error(), "cleanup unconfirmed")
+			cleaned, readErr := os.ReadFile(marker)
+			require.NoError(t, readErr, "Review returned before session cleanup")
+			require.Equal(t, "ses_review idle", string(cleaned))
+		})
+	}
+}
+
+func TestOpenCodeInterruptRetainedPipeIsUnconfirmed(t *testing.T) {
+	skipIfWindows(t)
+	for _, exitCode := range []int{0, 130} {
+		t.Run(fmt.Sprintf("exit=%d", exitCode), func(t *testing.T) {
+			pidFile := filepath.Join(t.TempDir(), "holder.pid")
+			t.Cleanup(func() {
+				data, err := os.ReadFile(pidFile)
+				var pid int
+				if err != nil {
+					return
+				}
+				if _, err := fmt.Sscan(string(data), &pid); err == nil && pid > 0 {
+					if process, err := os.FindProcess(pid); err == nil {
+						_ = process.Kill()
+					}
+				}
+			})
+			command := writeTempCommand(t, fmt.Sprintf(`#!/bin/sh
+case "$1" in *etxtbsy*) exit 0;; esac
+trap 'printf '"'"'%%s\n'"'"' '"'"'{"type":"session_cancelled","sessionID":"ses_review"}'"'"'; exit %d' INT
+sleep 60 &
+printf '%%s\n' "$!" > %q
+printf '%%s\n' '{"type":"step_start","sessionID":"ses_review"}'
+wait
+`, exitCode, pidFile))
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			started := time.Now()
+			result, err := runStreamingCLI(ctx, streamingCLISpec{
+				Name:                 "opencode",
+				Command:              command,
+				Output:               &interruptReadyWriter{cancel: cancel},
+				CaptureStdout:        true,
+				DrainStdout:          true,
+				InterruptGracePeriod: 50 * time.Millisecond,
+				Parse:                parseOpenCodeJSON,
+			})
+			require.ErrorIs(t, err, context.Canceled)
+			require.ErrorIs(t, result.WaitErr, exec.ErrWaitDelay)
+			require.Contains(t, result.Stdout, `"type":"session_cancelled"`)
+			require.Less(t, time.Since(started), 2*time.Second)
+		})
+	}
+}
+
+func TestOpenCodeInterruptCleanupTimeoutIsUnconfirmed(t *testing.T) {
+	skipIfWindows(t)
+	binary, err := os.Executable()
+	require.NoError(t, err)
+	marker := filepath.Join(t.TempDir(), "cleaned")
+	t.Setenv("ROBOREV_INTERRUPT_HELPER", "1")
+	t.Setenv("ROBOREV_INTERRUPT_MARKER", marker)
+	command := writeTempCommand(t, fmt.Sprintf("#!/bin/sh\ncase \"$1\" in *etxtbsy*) exit 0;; esac\nexec %q -test.run=^TestOpenCodeInterruptHelper$\n", binary))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := time.Now()
+	result, err := runStreamingCLI(ctx, streamingCLISpec{
+		Name:                 "opencode",
+		Command:              command,
+		Output:               &interruptReadyWriter{cancel: cancel},
+		CaptureStdout:        true,
+		InterruptGracePeriod: 50 * time.Millisecond,
+		Parse:                parseOpenCodeJSON,
+	})
+	require.ErrorIs(t, err, context.Canceled)
+	require.Less(t, time.Since(started), 2*time.Second)
+	require.Contains(t, result.Stdout, "ses_review")
+	require.NoFileExists(t, marker)
+}
+
+func TestOpenCodeReviewRequiresCancellationConfirmation(t *testing.T) {
+	skipIfWindows(t)
+	for _, tc := range []struct{ name, event, finish string }{
+		{"missing", "", "exit 130"},
+		{"wrong session", `{"type":"session_cancelled","sessionID":"ses_other"}`, "exit 130"},
+		{"failed exit", `{"type":"session_cancelled","sessionID":"ses_review"}`, "exit 1"},
+		{"timeout", `{"type":"session_cancelled","sessionID":"ses_review"}`, "while :; do :; done"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			command := writeTempCommand(t, fmt.Sprintf(`#!/bin/sh
+case "$1" in *etxtbsy*) exit 0;; esac
+trap 'printf '\''%%s\n'\'' '\''%s'\''; %s' INT
+printf '%%s\n' '{"type":"step_start","sessionID":"ses_review"}'
+while :; do :; done
+`, tc.event, tc.finish))
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			_, err := NewOpenCodeAgent(command).Review(ctx, t.TempDir(), "HEAD", "review", &interruptReadyWriter{cancel: cancel})
+			require.ErrorIs(t, err, context.Canceled)
+			require.ErrorContains(t, err, "cancellation cleanup unconfirmed")
+		})
+	}
+}
