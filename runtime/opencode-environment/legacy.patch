@@ -280,5 +280,7 @@
       env: Record<string, string>
       /** Opt into per-operation lookup. Removals precede env assignments, so later overlays win. */
       unset?: string[]
+      harborCanixLlmReplace?: boolean
+      harborLlmReplace?: boolean
     },
   ) => Promise<void>
